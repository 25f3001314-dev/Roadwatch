# ─── RoadWatch Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── Backend / Database ───────────────────────────────────────────────────────
DB_PASSWORD=your_supabase_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres

# ─── Mobile ───────────────────────────────────────────────────────────────────
# Set these in mobile/local.properties (also gitignored). Values shown here are
# placeholders only — never put real secrets in .env.example.
# api.base.url=http://16.176.***.7:8080/api/
# MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
